{
  "manifest_version": 3,
  "name": "AI Code Mentor",
  "description": "An AI-powered coding assistant for developers.",
  "version": "1.0.0",

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Code Mentor"
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
        "matches": [
            "<all_urls>"
        ],
        "js": [
            "content/content.js"
        ]
    }
],
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ]

}

